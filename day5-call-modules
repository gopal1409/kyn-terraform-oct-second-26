project_name    = "sap"
environment     = "dev"
resource_group_name = "gopal_rg"
location        = "eastus"

vnet_name               = "gopal-network"
vnet_address_space      = ["10.0.0.0/16"]
subnet_name             = "web-subnet"
subnet_address_prefixes = ["10.0.1.0/24"]

# Replace with your own public IP /32 before applying.
ssh_source_address_prefix = "203.0.113.10/32"
ssh_public_key_path       = "~/.ssh/azure_terraform.pub"

instance = {
  vm1 = {
    size              = "Standard_F2"
    availability_zone = "1"
  }
  vm2 = {
    size              = "Standard_B1s"
    availability_zone = "2"
  }
}


output "resource_group_name" {
  description = "Resource group created by the networking module."
  value       = module.networking.resource_group_name
}

output "location" {
  description = "Azure region used by this deployment."
  value       = module.networking.location
}

output "load_balancer_public_ip" {
  description = "Public IP address of the Azure Load Balancer."
  value       = module.load_balancer.public_ip_address
}

output "load_balancer_fqdn" {
  description = "DNS label is not configured in this example; use the public IP output."
  value       = null
}

output "vm_details" {
  description = "Virtual machine details, keyed by instance map key."
  value       = module.compute.vm_details
}
variable "project_name" {
  description = "Project name used as a resource name prefix."
  type        = string
  default     = "sap"
}

variable "environment" {
  description = "Deployment environment."
  type        = string
}

variable "resource_group_name" {
  description = "Suffix used in the resource group name."
  type        = string
  default     = "gopal_rg"
}

variable "location" {
  description = "Azure region."
  type        = string
  default     = "eastus"
}

variable "vnet_name" {
  description = "Virtual network name suffix."
  type        = string
  default     = "gopal-network"
}

variable "vnet_address_space" {
  description = "Virtual network CIDR ranges."
  type        = list(string)
  default     = ["10.0.0.0/16"]
}

variable "subnet_name" {
  description = "Subnet name suffix."
  type        = string
  default     = "web-subnet"
}

variable "subnet_address_prefixes" {
  description = "Subnet CIDR ranges."
  type        = list(string)
  default     = ["10.0.1.0/24"]
}

variable "instance" {
  description = "Map of VM names to size and Availability Zone."
  type = map(object({
    size              = string
    availability_zone = string
  }))
}

variable "ssh_public_key_path" {
  description = "Path to the SSH public key file on the workstation running Terraform."
  type        = string
  default     = "~/.ssh/id_rsa.pub"
}

variable "ssh_source_address_prefix" {
  description = "Trusted source CIDR for SSH, e.g. 203.0.113.10/32. Replace before deployment."
  type        = string
  default     = "0.0.0.0/0"
}

variable "admin_username" {
  description = "Linux VM administrator username."
  type        = string
  default     = "azureuser"
}

variable "lb_frontend_port" {
  description = "Load balancer frontend TCP port."
  type        = number
  default     = 80
}

variable "lb_backend_port" {
  description = "Backend VM TCP port."
  type        = number
  default     = 80
}
