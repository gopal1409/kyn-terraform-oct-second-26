#create file publicip.tf copy from line 2 till 11
  resource "azurerm_public_ip" "web_public_ip" {
  name                = "${local.name_prefix}-public-ip"
  resource_group_name = azurerm_resource_group.my_rg.name
  location            = azurerm_resource_group.my_rg.location
  allocation_method   = "Static"
  sku                 = "Standard" #publicip ip will be spread across regions and will be highly available across zones
  #basic: the public ip created in one single az 

  tags = local.project_tag
}

##create a nic card nic.tf copy from line 14 till 26
  resource "azurerm_network_interface" "web_nic" {
  name                = "${local.name_prefix}-nic"
  resource_group_name = azurerm_resource_group.my_rg.name
  location            = azurerm_resource_group.my_rg.location
  

  ip_configuration { #this nic card will get an public and private ip
    name                          = "internal"
    subnet_id                     = azurerm_subnet.web_subnet.id 
    private_ip_address_allocation = "Dynamic"
    public_ip_address_id          = azurerm_public_ip.web_public_ip.id
  }
}

