##create another file vnet.tf change my name to your name copy line 2 till 7
resource "azurerm_virtual_network" "vnet" {
  name                = "gopal-network"
  location            =  azurerm_resource_group.my_rg.location
  resource_group_name =  azurerm_resource_group.my_rg.name
  address_space       = ["10.0.0.0/16"]
}

#then do terraform apply inside your resource group you will see the vnet. 

